{
  "name": "devloop-v2",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "pipeline": "pnpm --filter pipeline pipeline",
    "apply-schema": "pnpm --filter pipeline apply-schema",
    "migrate-registry": "pnpm --filter pipeline migrate-registry",
    "api": "pnpm --filter api start",
    "web": "pnpm --filter web dev",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0"
  }
}
