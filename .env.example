# 필수 (apps/api) — 없으면 API 기동이 실패한다.
NEO4J_URI=bolt://localhost:7687
# 자격증명은 아래 두 경로 중 하나로 준다. 둘 다 있으면 NEO4J_USER/NEO4J_PASSWORD 쌍이 우선한다.
NEO4J_AUTH=neo4j/devloop-password
NEO4J_USER=neo4j
NEO4J_PASSWORD=devloop-password
LLM_PROVIDER=codex
# 파이프라인 추출은 LLM_MODEL, API 질의는 QUERY_LLM_MODEL을 사용한다.
# API는 QUERY_LLM_MODEL이 없어도 LLM_MODEL로 대체하지 않고 기동을 멈춘다.
QUERY_LLM_MODEL=gpt-5.6-terra

# 선택 (apps/api) — 생략하면 괄호 안 기본값을 쓴다.
# PORT=3000                      (3000)
# NEO4J_DATABASE=neo4j           (neo4j)
# LLM_REASONING_EFFORT=medium    (미지정. minimal|low|medium|high)

# 파이프라인과 docker-compose 전용
NEO4J_TEST_URI=bolt://localhost:7688
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
LLM_MODEL=gpt-5.5
