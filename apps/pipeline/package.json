{
  "name": "pipeline",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm --filter @devloop/shared build && pnpm --filter @devloop/registry build && pnpm --filter @devloop/llm build && tsc -p tsconfig.json && cp src/neo4j/schema.cy dist/neo4j/schema.cy",
    "fetch-dooray": "pnpm build && node dist/main.js fetch-dooray",
    "pipeline": "pnpm build && node dist/main.js",
    "start": "node dist/main.js",
    "sync-neo4j": "pnpm build && node dist/neo4j/sync.js",
    "resolve-graph": "pnpm build && node dist/resolve/cli.js",
    "reset-neo4j": "pnpm build && node dist/neo4j/reset.js",
    "audit-concepts": "pnpm build && node dist/concepts/audit.js",
    "apply-schema": "pnpm build && node dist/neo4j/apply-schema.js",
    "seed-concepts": "pnpm build && node dist/main.js seed-concepts",
    "parse-structure": "pnpm build && node dist/main.js parse-structure",
    "infer-knowledge": "pnpm build && node dist/main.js infer-knowledge",
    "normalize-memory": "pnpm build && node dist/memory/cli.js normalize",
    "migrate-registry": "pnpm build && node dist/registry/migrate.js",
    "register-project": "pnpm build && node dist/registry/register-project.js",
    "import-curation": "pnpm build && node dist/registry/import-curation.js",
    "export-curation": "pnpm build && node dist/registry/export-curation.js",
    "test": "pnpm --filter @devloop/shared build && pnpm build && node --test dist/*.test.js dist/config/*.test.js dist/fetch/*.test.js dist/infer/*.test.js dist/llm/*.test.js dist/memory/*.test.js dist/neo4j/*.test.js dist/parse/*.test.js dist/registry/*.test.js dist/resolve/*.test.js test/*.test.cjs"
  },
  "dependencies": {
    "@devloop/llm": "workspace:*",
    "@devloop/registry": "workspace:*",
    "@devloop/shared": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.0",
    "neo4j-driver": "^5.28.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^3.25.0"
  }
}
