{
  "name": "pipeline",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm --filter @devloop/shared build && tsc -p tsconfig.json && cp src/neo4j/schema.cy dist/neo4j/schema.cy",
    "ingest": "pnpm build && node dist/main.js ingest",
    "pipeline": "pnpm build && node dist/main.js",
    "start": "node dist/main.js",
    "load": "pnpm build && node dist/neo4j/sync.js",
    "concepts:audit-normalization": "pnpm build && node dist/concepts/audit.js",
    "schema:apply": "pnpm build && node dist/neo4j/apply-schema.js",
    "concepts:seed": "pnpm build && node dist/main.js concepts:seed",
    "extract:structural": "pnpm build && node dist/main.js extract:structural",
    "extract:llm": "pnpm build && node dist/main.js extract:llm",
    "test": "pnpm --filter @devloop/shared build && pnpm build && node --test dist/cli-options.test.js dist/fetch/*.test.js dist/neo4j/*.test.js test/*.test.cjs"
  },
  "dependencies": {
    "@devloop/shared": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "neo4j-driver": "^5.28.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^3.25.0"
  }
}
